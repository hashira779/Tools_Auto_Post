# CAMTECH Environment Variables
# ------------------------------
# Copy this file to .env and fill in your real values.
# NEVER commit real credentials to git.

# 1. Supabase Database Connection String (Confidential)
# Found in Supabase Dashboard: Project Settings > Database > Connection string (URI)
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@YOUR_POOLER_HOST:6543/postgres

# 2. Supabase API Keys
# Found in Supabase Dashboard: Project Settings > API
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# 3. Telegram Bot (Auto Post Bot)
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN

# 4. Cloudflare Tunnel (optional)
CLOUDFLARE_TUNNEL_TOKEN=YOUR_CLOUDFLARE_TUNNEL_TOKEN

# 5. TURN server (Live Camera / WebRTC)
TURN_SECRET=YOUR_TURN_STATIC_AUTH_SECRET

# 6. n8n Workflow Automation
N8N_USER=admin
N8N_PASSWORD=your_n8n_password_here

# 7. PostgreSQL (shared DB for n8n + services). Required — compose fails if unset.
POSTGRES_PASSWORD=YOUR_STRONG_DB_PASSWORD

# 8. n8n Google Sign-In bypass shared secret. Required for the Google login flow.
#    Must match the value the frontend sends (services/patched_index.html).
#    Rotate this if it ever leaks.
N8N_GOOGLE_BYPASS_SECRET=YOUR_LONG_RANDOM_BYPASS_SECRET

# 9. Deploy script sudo password (used by scripts/deploy_production.sh).
#    Prefer setting this in ~/.camtech_env instead of a committed file.
CAMTECH_SUDO_PASS=YOUR_SERVER_SUDO_PASSWORD
